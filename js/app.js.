import { auth, db } from "./firebase.js";
import {
  createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged,
  signOut, updateProfile
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";
import {
  collection, addDoc, doc, getDoc, setDoc, updateDoc, deleteDoc, query, where,
  getDocs, serverTimestamp, orderBy
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";

const $ = id => document.getElementById(id);
let currentUser = null, userProfile = {}, tasks = [], authMode = "login", activeView = "dashboard";
const authView = $("authView"), appView = $("appView"), dialog = $("taskDialog");
const esc = value => String(value ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const initials = name => (name || "U").trim().split(/\s+/).slice(0,2).map(x=>x[0]).join("").toUpperCase();
function toast(message){const el=$("toast");el.textContent=message;el.classList.add("show");setTimeout(()=>el.classList.remove("show"),2600)}
function setAuthMessage(message){$("authMessage").textContent=message}
function showAuth(mode){authMode=mode;const signup=mode==="signup";$("authEyebrow").textContent=signup?"GET STARTED":"WELCOME BACK";$("authTitle").textContent=signup?"Create your account":"Sign in to your workspace";$("authSubtitle").textContent=signup?"Set up your personal task workspace.":"Enter your details to continue.";$("nameField").classList.toggle("hidden",!signup);$("departmentField").classList.toggle("hidden",!signup);$("authSubmit").innerHTML=signup?"Create account <span>→</span>":"Sign in <span>→</span>";$("authSwitch").innerHTML=signup?'Already have an account? <button id="toggleAuth" class="text-button">Sign in</button>':'New to TaskFlow? <button id="toggleAuth" class="text-button">Create an account</button>'; $("toggleAuth").addEventListener("click",()=>showAuth(signup?"login":"signup"));$("password").autocomplete=signup?"new-password":"current-password";setAuthMessage("")}
$("toggleAuth").addEventListener("click",()=>showAuth("signup"));
$("authForm").addEventListener("submit",async e=>{e.preventDefault();setAuthMessage("");$("authSubmit").disabled=true;try{const email=$("email").value.trim(),password=$("password").value;if(authMode==="signup"){const name=$("fullName").value.trim();if(!name)throw Error("Please enter your full name.");const cred=await createUserWithEmailAndPassword(auth,email,password);await updateProfile(cred.user,{displayName:name});await setDoc(doc(db,"users",cred.user.uid),{uid:cred.user.uid,fullName:name,email,department:$("department").value.trim(),createdAt:serverTimestamp()});}else{await signInWithEmailAndPassword(auth,email,password)}}catch(err){setAuthMessage(friendlyError(err))}finally{$("authSubmit").disabled=false}});
function friendlyError(err){const map={"auth/email-already-in-use":"An account already exists with this email.","auth/invalid-email":"Please enter a valid email address.","auth/weak-password":"Use a password with at least 6 characters.","auth/invalid-credential":"Incorrect email or password.","auth/user-not-found":"No account was found for this email.","auth/wrong-password":"Incorrect email or password.","permission-denied":"Database permission denied. Check your Firestore security rules."};return map[err.code]||err.message||"Something went wrong."}
onAuthStateChanged(auth,async user=>{if(user){currentUser=user;authView.classList.add("hidden");appView.classList.remove("hidden");await loadProfile();await loadTasks();renderAll()}else{currentUser=null;tasks=[];appView.classList.add("hidden");authView.classList.remove("hidden");showAuth("login")}});
async function loadProfile(){const snap=await getDoc(doc(db,"users",currentUser.uid));userProfile=snap.exists()?snap.data():{fullName:currentUser.displayName||currentUser.email,email:currentUser.email,department:""};const name=userProfile.fullName||currentUser.displayName||"User";$("sideName").textContent=name;$("sideEmail").textContent=currentUser.email;$("sideAvatar").textContent=initials(name);$("topName").textContent=name;$("topAvatar").textContent=initials(name);$("profileName").textContent=name;$("profileEmail").textContent=currentUser.email;$("profileAvatar").textContent=initials(name);$("profileNameDetail").textContent=name;$("profileDepartment").textContent=userProfile.department||"Not provided";const created=userProfile.createdAt?.toDate?.();$("profileCreated").textContent=created?created.toLocaleDateString():"—";$("welcomeTitle").textContent=`Welcome back, ${name.split(" ")[0]} 👋`}
async function loadTasks(){const ownQ=query(collection(db,"tasks"),where("createdBy","==",currentUser.uid));const assignedQ=query(collection(db,"tasks"),where("assignedToEmail","==",currentUser.email));const [own,assigned]=await Promise.all([getDocs(ownQ),getDocs(assignedQ)]);const byId=new Map();[...own.docs,...assigned.docs].forEach(s=>byId.set(s.id,{id:s.id,...s.data()}));tasks=[...byId.values()].sort((a,b)=>(b.createdAt?.seconds||0)-(a.createdAt?.seconds||0))}
function isOverdue(t){return t.status!=="Completed"&&t.dueDate&&t.dueDate<new Date().toISOString().slice(0,10)}
function renderAll(){const own=tasks.filter(t=>t.createdBy===currentUser.uid);const completed=own.filter(t=>t.status==="Completed").length;const pending=own.filter(t=>t.status==="To Do").length;const progress=own.filter(t=>t.status==="In Progress").length;$("totalCount").textContent=own.length;$("pendingCount").textContent=pending;$("progressCount").textContent=progress;$("completedCount").textContent=completed;$("overdueCount").textContent=`${own.filter(isOverdue).length} overdue task${own.filter(isOverdue).length===1?"":"s"}`;const pct=own.length?Math.round(completed/own.length*100):0;$("completionPercent").textContent=pct+"%";$("completionBar").style.width=pct+"%";$("todayDate").textContent=new Date().toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric"});$("dateLabel").textContent=new Date().toLocaleDateString(undefined,{month:"long",year:"numeric"}).toUpperCase();$("recentTasks").innerHTML=renderTaskRows(own.slice(0,5),false);$("taskList").innerHTML=renderTaskRows(own.filter(matchesFilters),true);$("assignedList").innerHTML=renderTaskRows(tasks.filter(t=>t.assignedToEmail===currentUser.email&&t.createdBy!==currentUser.uid),true);$("completedList").innerHTML=renderTaskRows(own.filter(t=>t.status==="Completed"),true)}
function matchesFilters(t){const q=$("searchInput").value.toLowerCase(),s=$("statusFilter").value,p=$("priorityFilter").value;return (!q||`${t.title} ${t.description||""} ${t.category||""}`.toLowerCase().includes(q))&&(!s||t.status===s)&&(!p||t.priority===p)}
function renderTaskRows(items,actions){if(!items.length)return '<div class="empty-state"><strong>No tasks to show</strong>Create a task or adjust your filters to see it here.</div>';return items.map(t=>`<article class="task-row"><input class="task-check" type="checkbox" ${t.status==="Completed"?"checked":""} data-complete="${esc(t.id)}" aria-label="Mark ${esc(t.title)} completed"><div class="task-main"><strong>${esc(t.title)}</strong><small>${esc(t.category||"General")} · ${t.dueDate?`Due ${esc(t.dueDate)}`:"No deadline"}${isOverdue(t)?" · OVERDUE":""}</small></div><div class="task-meta"><span class="pill priority-${esc(t.priority||"Medium")}">${esc(t.priority||"Medium")}</span><span class="pill status-pill">${esc(t.status||"To Do")}</span></div>${actions&&t.createdBy===currentUser.uid?`<div class="task-actions"><button class="icon-button" data-edit="${esc(t.id)}" title="Edit task">✎</button><button class="icon-button" data-delete="${esc(t.id)}" title="Delete task">×</button></div>`:""}</article>`).join("")}
function switchView(view){activeView=view;document.querySelectorAll(".view").forEach(el=>el.classList.add("hidden"));$(view+"View").classList.remove("hidden");document.querySelectorAll(".nav-item[data-view]").forEach(b=>b.classList.toggle("active",b.dataset.view===view));const titles={dashboard:"Overview",tasks:"My tasks",assigned:"Assigned to me",completed:"Completed tasks",profile:"Profile & settings"};$("pageTitle").textContent=titles[view]||"Overview";if(view==="tasks")renderAll()}
document.querySelectorAll("[data-view]").forEach(b=>b.addEventListener("click",()=>switchView(b.dataset.view)));
document.querySelectorAll("[data-go]").forEach(b=>b.addEventListener("click",()=>switchView(b.dataset.go)));
$("profileButton").addEventListener("click",()=>switchView("profile"));
$("logoutButton").addEventListener("click",()=>signOut(auth));
function openTask(t=null){$("taskForm").reset();$("taskMessage").textContent="";$("taskId").value=t?.id||"";$("dialogTitle").textContent=t?"Edit task":"Create a task";$("taskTitle").value=t?.title||"";$("taskDescription").value=t?.description||"";$("taskPriority").value=t?.priority||"Medium";$("taskStatus").value=t?.status||"To Do";$("taskCategory").value=t?.category||"";$("taskDueDate").value=t?.dueDate||"";$("taskAssigned").value=t?.assignedToEmail||"";dialog.showModal()}
$("newTaskButton").addEventListener("click",()=>openTask());$("newTaskButton2").addEventListener("click",()=>openTask());$("closeDialog").addEventListener("click",()=>dialog.close());$("cancelTask").addEventListener("click",()=>dialog.close());
$("taskForm").addEventListener("submit",async e=>{e.preventDefault();$("taskMessage").textContent="";const id=$("taskId").value;const payload={title:$("taskTitle").value.trim(),description:$("taskDescription").value.trim(),priority:$("taskPriority").value,status:$("taskStatus").value,category:$("taskCategory").value.trim()||"General",dueDate:$("taskDueDate").value,assignedToEmail:$("taskAssigned").value.trim().toLowerCase(),updatedAt:serverTimestamp()};if(!payload.title){$("taskMessage").textContent="Task title is required.";return}try{if(id){const existing=tasks.find(t=>t.id===id);if(existing?.createdBy!==currentUser.uid)throw Error("You can only edit tasks you created.");await updateDoc(doc(db,"tasks",id),payload)}else{await addDoc(collection(db,"tasks"),{...payload,createdBy:currentUser.uid,createdByEmail:currentUser.email,createdAt:serverTimestamp()})}dialog.close();await loadTasks();renderAll();toast(id?"Task updated successfully":"Task created successfully")}catch(err){$("taskMessage").textContent=friendlyError(err)}});
document.addEventListener("click",async e=>{const edit=e.target.closest("[data-edit]"),del=e.target.closest("[data-delete]");if(edit){const t=tasks.find(x=>x.id===edit.dataset.edit);if(t)openTask(t)}if(del){if(!confirm("Delete this task permanently?"))return;try{const t=tasks.find(x=>x.id===del.dataset.delete);if(t?.createdBy!==currentUser.uid)throw Error("You can only delete tasks you created.");await deleteDoc(doc(db,"tasks",del.dataset.delete));await loadTasks();renderAll();toast("Task deleted")}catch(err){toast(friendlyError(err))}}});
document.addEventListener("change",async e=>{const id=e.target.dataset.complete;if(!id)return;const t=tasks.find(x=>x.id===id);if(!t)return;const status=e.target.checked?"Completed":"To Do";try{if(t.createdBy===currentUser.uid){await updateDoc(doc(db,"tasks",id),{status,updatedAt:serverTimestamp()})}else{await updateDoc(doc(db,"tasks",id),{status,updatedAt:serverTimestamp()})}await loadTasks();renderAll();toast("Task status updated")}catch(err){e.target.checked=!e.target.checked;toast(friendlyError(err))}});
["searchInput","statusFilter","priorityFilter"].forEach(id=>$(id).addEventListener("input",renderAll));
